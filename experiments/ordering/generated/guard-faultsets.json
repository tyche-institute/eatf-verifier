{
  "schema": "urn:eatf:experiment:guard-faultsets:1",
  "environment": {
    "python": "3.12.3"
  },
  "method": "guards evaluated independently via the shipped public components; no verifier source modified",
  "summary": {
    "cases": 25,
    "guards_evaluated_per_case": 10,
    "sentinel_accepting_controls": "2 checked, all with an empty fault set",
    "sentinel_completeness": "every package the shipped verifier rejects has at least one rejecting guard here, and every one it accepts has none",
    "cases_with_no_rejecting_guard": 3,
    "cases_with_exactly_one_rejecting_guard": 15,
    "cases_with_more_than_one_rejecting_guard": 7,
    "order_sensitive_ids": [
      "canonical-mismatch",
      "hash-mismatch",
      "overt-content-hash-mismatch",
      "zip-duplicate-entry",
      "zip-too-many-entries",
      "naive-empty-timestamp",
      "naive-remove-receipt-signature"
    ],
    "max_fault_set_size": 3,
    "note": "A case with one rejecting guard receives the same first-failure code under every ordering of the guards; that is analytic. A case with more than one rejecting guard receives a code that depends on which of them the implementation reaches first, so for those cases the standard's permission to reorder does not preserve the code. Guards whose own inputs are not well defined for a package are reported as unevaluable and are counted in neither direction."
  },
