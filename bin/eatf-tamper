#!/usr/bin/env python3
"""Flip one byte in canonical.bin to demonstrate verifier rejection."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import tempfile
import zipfile

MAX_ARCHIVE_BYTES = 64 * 1024 * 1024
MAX_ENTRY_BYTES = 16 * 1024 * 1024
MAX_EXPANDED_BYTES = 32 * 1024 * 1024
MAX_ENTRIES = 32


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="eatf-tamper",
        description="Flip one byte in canonical.bin in a copy of an AEP package.",
    )
    parser.add_argument("path", type=Path)
    parser.add_argument(
        "--offset",
        type=int,
        default=0,
        help="Zero-based byte offset inside canonical.bin (default: 0).",
    )
    parser.add_argument(
        "--output",
        type=Path,
        help="Output path (default: <input>-tampered.aep).",
    )
    args = parser.parse_args()

    if not args.path.is_file():
        parser.error(f"input is not a file: {args.path}")
    if args.path.stat().st_size > MAX_ARCHIVE_BYTES:
        parser.error("input exceeds the 64 MiB archive safety limit")
    if args.offset < 0:
        parser.error("--offset must be non-negative")
    output = args.output or args.path.with_name(
        f"{args.path.stem}-tampered{args.path.suffix}"
    )

    try:
        with zipfile.ZipFile(args.path, "r") as source:
            infos = source.infolist()
            names = [info.filename for info in infos]
            if len(infos) > MAX_ENTRIES:
                parser.error("input has too many ZIP entries")
            if len(set(names)) != len(names):
                parser.error("input has duplicate ZIP entries")
            if any(info.file_size > MAX_ENTRY_BYTES for info in infos):
                parser.error("input has an oversized ZIP entry")
            if sum(info.file_size for info in infos) > MAX_EXPANDED_BYTES:
                parser.error("input exceeds the expanded ZIP safety limit")
            members = [(info, source.read(info)) for info in infos]
    except (OSError, zipfile.BadZipFile) as exc:
        parser.error(f"cannot read AEP ZIP: {exc}")

    found = False
    rewritten: list[tuple[zipfile.ZipInfo, bytes]] = []
    for info, data in members:
        if info.filename == "canonical.bin":
            found = True
            if args.offset >= len(data):
                parser.error(
                    f"--offset {args.offset} is outside canonical.bin ({len(data)} bytes)"
                )
            changed = bytearray(data)
            changed[args.offset] ^= 0x01
            data = bytes(changed)
        rewritten.append((info, data))
    if not found:
        parser.error("package has no canonical.bin entry")

    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        dir=output.parent, prefix=f".{output.name}.", suffix=".tmp", delete=False
    ) as temp:
        temp_path = Path(temp.name)
    try:
        with zipfile.ZipFile(temp_path, "w") as target:
            for info, data in rewritten:
                target.writestr(info, data)
        os.replace(temp_path, output)
    finally:
        temp_path.unlink(missing_ok=True)

    print(f"Tampered canonical.bin byte {args.offset}: {output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
